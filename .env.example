PORT=3001
HOST=0.0.0.0

# Required API protection token
AUTH_TOKEN=change-this-to-a-long-random-secret

# Optional Z.AI token
ZAI_TOKEN=

# Optional captcha provider credentials
ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_SCENE_ID=

# Restrict browser clients
CORS_ORIGIN=https://your-domain.example

SESSION_POOL_SIZE=5
SESSION_ACQUIRE_TIMEOUT=10
